cabal-version: 2.2
name:           codigo1
version:        0.1.0.0
description:    Proyecto de Haskell con interfaz grafica y algoritmos de cifrado.
author:         Ian
maintainer:     ian_arroyo@ciencias.unam.mx
build-type:     Simple

library
  exposed-modules:
      Cifrados
      Cifrados.Cesar
      Cifrados.Decimado
      Cifrados.Afin
      Cifrados.Vigenere
      Cifrados.Hill
      Cifrados.RSA
      Cifrados.ElGamal
      Cifrados.AlbertiLetras
      Cifrados.AlbertiNumeros
      Cifrados.Tipos
      Cifrados.Utilidades
  hs-source-dirs:
      src
  build-depends:
      base >=4.7 && <5
  default-language: Haskell2010

executable codigo1-exe
  main-is: Main.hs
  hs-source-dirs:
      src
  ghc-options: -threaded -rtsopts -with-rtsopts=-N
  build-depends:
      base >=4.7 && <5
    , codigo1
    , threepenny-gui
    , process
  default-language: Haskell2010

test-suite codigo1-test
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  other-modules:
      CifradosSpec
  hs-source-dirs:
      test
  ghc-options: -threaded -rtsopts -with-rtsopts=-N
  build-depends:
      base >=4.7 && <5
    , codigo1
    , hspec
    , QuickCheck
  build-tool-depends:
      hspec-discover:hspec-discover
  default-language: Haskell2010
